    "/api/v1/admin/users": {
      "get": {
        "operationId": "AdminController_listUsers",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "DRAFT",
                "PENDING_VERIFICATION",
                "UNDER_REVIEW",
                "ACTIVE",
                "SUSPENDED",
                "REJECTED",
                "CLOSED"
              ]
            }
          },
          {
            "name": "role",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "buyer",
                "business_buyer",
                "seller",
                "business_seller",
                "logistics_partner",
                "freight_consolidator",
                "customs_broker",
                "payment_partner",
                "customer_support",
                "compliance_officer",
                "country_admin",
                "super_admin"
              ]
            }
          },
          {
            "name": "countryCode",
            "required": false,
            "in": "query",
            "schema": {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "admin"
        ]
      }
    },
