# IIE staging settings. Copy to .env on the server (chmod 600) and fill in every value.
# Never commit the filled-in file. Generate secrets on the server, e.g. `openssl rand -base64 32`.

# Public address, e.g. staging.interislandexchange.com. Its DNS must point at this server.
SITE_DOMAIN=
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=info@interislandexchange.com

POSTGRES_PASSWORD=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts two-step verification secrets.
MFA_ENCRYPTION_KEY=
# Signs sandbox payment pages and sandbox webhooks (openssl rand -hex 32). Payments are sandbox-only until a
# licensed provider is contracted.
SANDBOX_PAYMENT_SECRET=

# Shown on every page and at the top of every email while the pilot is a rehearsal with test orders.
ENVIRONMENT_LABEL="Pilot rehearsal"

# Email through Gmail (Google Account > Security > App passwords; 2-Step Verification must be on).
EMAIL_FROM="Inter-Island Exchange (staging) <your-account@gmail.com>"
SMTP_USER=
SMTP_PASS=

# Where backup.sh writes; keep a second copy off this server.
BACKUP_DIR=/var/backups/iie
BACKUP_KEEP_DAYS=14
