{
  "name": "inter-island-exchange",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @iie/api dev",
    "dev:worker": "pnpm --filter @iie/api dev:worker",
    "dev:web": "pnpm --filter @iie/web dev",
    "db:migrate": "pnpm --filter @iie/api db:migrate",
    "db:seed": "pnpm --filter @iie/api db:seed",
    "e2e": "pnpm --filter @iie/web e2e"
  }
}
