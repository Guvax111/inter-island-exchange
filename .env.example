# ---------- API (apps/api) ----------
# local | test | staging | production. Production refuses sandbox providers, insecure cookies and non-https URLs.
APP_ENV=local
API_PORT=4000
DATABASE_URL=postgres://iie:iie@127.0.0.1:5432/iie
# Public web URL, used for links in emails and as the allowed request origin.
WEB_BASE_URL=http://localhost:3000
# Behind the Next.js proxy or a load balancer, trust one proxy hop so rate limits see the real client IP.
TRUST_PROXY=true
# Must be true wherever the site is served over https (always in staging/production).
COOKIE_SECURE=false
SESSION_ABSOLUTE_HOURS=336
SESSION_IDLE_HOURS=72
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts two-step verification secrets. Use a different key per environment.
MFA_ENCRYPTION_KEY=
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=10
# Deliver emails from the API process (local only). In staging/production run the worker instead.
OUTBOX_IN_PROCESS=true

# Email. `sandbox` prints emails to the API log (local/test only).
EMAIL_PROVIDER=sandbox
EMAIL_FROM="Inter-Island Exchange <your-account@gmail.com>"
# Gmail (initial provider): turn on 2-Step Verification for the Google account, create an App Password
# (Google Account > Security > App passwords), then set:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=<16-character app password>

# Product images. `local` stores them on disk (local/test and single-server staging only; refused in production).
STORAGE_PROVIDER=local
MEDIA_LOCAL_DIR=.media
MAX_UPLOAD_MB=8

# Payments. `sandbox` is a test payment page and signed test webhooks: no real money. It is the only provider until a
# licensed one is contracted, and production refuses to start with it. The secret is required outside local/test.
PAYMENT_PROVIDER=sandbox
# SANDBOX_PAYMENT_SECRET=<openssl rand -hex 32>

# ---------- Web (apps/web) ----------
# Where the Next.js server reaches the API. Set it when BUILDING the web app as well as when running it:
# Next.js fixes the browser-facing /api/v1 proxy target at build time.
API_ORIGIN=http://127.0.0.1:4000
# Optional, build time: shows a banner on every page and keeps the site out of search engines (e.g. Staging).
# NEXT_PUBLIC_ENVIRONMENT_LABEL=
